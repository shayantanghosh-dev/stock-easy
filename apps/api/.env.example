# ---- Stock Easy API environment ----
# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection (must match the Prisma datasource).
# Used by Prisma Client at runtime AND by the Prisma CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockeasy?schema=public"

# DIRECT_URL is REQUIRED. prisma/schema.prisma declares `directUrl = env("DIRECT_URL")`, so every
# Prisma CLI command (migrate deploy/status, validate, db seed) needs it — without it they fail with
# error P1012. It is NOT read by the running server (Prisma Client uses only DATABASE_URL at runtime),
# but it must be set wherever the Prisma CLI runs: your local shell, CI, and the Render build.
#   • Non-pooled database  → set DIRECT_URL EQUAL to DATABASE_URL.
#   • Pooled database (e.g. a Neon "-pooler" host) → set DATABASE_URL to the POOLED string and
#     DIRECT_URL to the DIRECT (non-pooled) string.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/stockeasy?schema=public"

# JWT secrets — generate strong random values in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-0123456789"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-0123456789"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=12

# CORS: comma-separated allowlist of web origins that may send credentialed
# requests. "*" is rejected — list explicit origins. Must include the web app's
# origin (the Next.js dev server runs on :3000).
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL=info

# GenAI assistant — Google Gemini (optional; the /ai routes return 503 until GEMINI_API_KEY is set).
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
