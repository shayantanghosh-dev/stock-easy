# ── API connection ───────────────────────────────────────────────────────────
# Base URL of the Stock Easy API, INCLUDING the /api/v1 version prefix.
# NEXT_PUBLIC_API_URL is inlined into the browser bundle at build time — set it
# BEFORE `next build` (changing it later requires a rebuild).

# Local development — talk to the API directly:
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production (RECOMMENDED — same-origin proxy; no custom domain, no code change):
#   The refresh cookie is httpOnly + SameSite=Strict, so the browser must ONLY ever talk to the WEB
#   origin, or the cookie is dropped on POST /auth/refresh and users get logged out on reload / after
#   the access token expires. apps/web/next.config.mjs proxies /api/* to the API server-side when
#   API_PROXY_TARGET is set, keeping the cookie first-party. In production therefore set BOTH:
#     NEXT_PUBLIC_API_URL=/api/v1                          # relative → browser calls the web origin
#     API_PROXY_TARGET=https://your-api-host.example       # the API ORIGIN (no /api/v1 suffix)
#
# API_PROXY_TARGET is read ONLY by the Next.js server (it is NOT a NEXT_PUBLIC_* value, so it never
# reaches the browser). Leave it unset locally → no proxy; the app calls NEXT_PUBLIC_API_URL directly.
# API_PROXY_TARGET=

# Optional display currency symbol (defaults to ₹):
# NEXT_PUBLIC_CURRENCY=₹
